# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Data
# data/raw/* ignores everything main's `data/raw/` ignored, but keeps data/raw/.gitkeep
# trackable (git cannot re-include a file inside an ignored folder).
data/raw/*
!data/raw/.gitkeep
data/processed/

# Generated model files
*.joblib
*.pkl

# Jupyter
.ipynb_checkpoints/

# Python tooling
*.egg-info/
.eggs/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment files
.env
.env.*

# Node
node_modules/
dist/
npm-debug.log*
yarn-error.log*

# Large artifacts
artifacts/models/*.joblib

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Golden copies of an earlier refactor check, and the output of runs on the fake sample
.golden/
.golden_before/
artifacts/sample/
