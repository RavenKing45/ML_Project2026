# The real dataset is never committed (download it from Kaggle); the .gitkeep keeps the folder.
data/raw/*
!data/raw/.gitkeep

# Outputs of trial runs on the fake sample
artifacts/sample/

# Trained pipelines stay local, except the LightGBM ones the app loads (each about 2.4 MB)
artifacts/models/*
!artifacts/models/.gitkeep
!artifacts/models/lightgbm__*.joblib

# Python, pip install -e and Jupyter leftovers
.venv/
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Secrets
.env
