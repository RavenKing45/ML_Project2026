# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Data
# data/raw/* ignores everything main's `data/raw/` ignored, but keeps data/raw/.gitkeep
# trackable (git cannot re-include a file inside an ignored folder).
data/raw/*
!data/raw/.gitkeep
data/processed/

# Generated model files
*.joblib
*.pkl

# Jupyter
.ipynb_checkpoints/

# Python tooling
*.egg-info/
.eggs/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment files
.env
.env.*

# Node
node_modules/
dist/
npm-debug.log*
yarn-error.log*

# Large artifacts
artifacts/models/*.joblib
# Except the deployed models (scripts/export_artifacts.py): the backend image is built from them.
# Only this folder; cells/ and sample/ stay ignored. Keep each file under the 10 MB commit limit.
!artifacts/models/deploy/*.joblib

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Golden copy and sample-run output (scripts/golden.py, scripts/run_all_sample.py)
.golden/
artifacts/sample/
